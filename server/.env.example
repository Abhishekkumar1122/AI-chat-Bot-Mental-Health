PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/mental-health-chatbot
# If local MongoDB is unavailable in development, server auto-falls back to in-memory MongoDB.
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173


OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Gemini (Google AI) support
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-pro

ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
